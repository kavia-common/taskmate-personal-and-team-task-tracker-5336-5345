# TaskMate environment configuration
# Copy this file to `.env` and adjust values for your environment.
# Note: Do not commit real secrets. Firebase client config is not secret, but follow your org policies.

# App behavior
# Enable in-memory Preview Mode (no Firebase backend required).
# When true, the app uses lib/main_preview.dart mocks and seeds data. You can also run: flutter run -t lib/main_preview.dart
PREVIEW_MODE=false

# Firestore Emulator flags (optional)
# Only used when PREVIEW_MODE is false. Useful for local Firebase-backed development without touching production.
USE_FIRESTORE_EMULATOR=false
# For Android emulator, consider using 10.0.2.2 to reach host machine.
FIRESTORE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_PORT=8080

# Firebase project configuration (non-secret client-side values)
# Production builds rely on FlutterFire-generated lib/core/firebase_options.dart.
# These variables are defined in lib/core/constants/env_keys.dart for parity and optional overrides if you add custom logic.
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Google Sign-In client ID (optional; depends on your auth configuration)
GOOGLE_CLIENT_ID=
