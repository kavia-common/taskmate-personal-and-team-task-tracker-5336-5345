# TaskMate Flutter App - Environment Configuration
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# Firebase core (use values from your Firebase console or flutterfire configure)
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Google Sign-In Client ID (iOS/Android as applicable)
GOOGLE_CLIENT_ID=

# Use Firestore emulator for local dev (true/false)
USE_FIRESTORE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_PORT=8080

# App preview mode (true/false). If true, certain features may run with local stubs.
PREVIEW_MODE=true
